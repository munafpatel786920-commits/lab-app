        "testName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["reportNo", "patientId", "testName"]
    },
    "invoices": {
      "title": "Invoice",
      "description": "Billing invoices",
      "properties": {
        "invoiceNo": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "total": { "type": "number" },
        "paymentStatus": { "type": "string" }
