      "required": ["id", "name", "mobile"]
    },
    "reports": {
      "title": "TestReport",
      "description": "Lab test reports",
      "properties": {
        "reportNo": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
